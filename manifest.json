{
  "manifest_version": 3,
  "name": "Webtoon Çevirmen (EN → TR)",
  "version": "1.0.0",
  "description": "Seçtiğiniz webtoon sitelerindeki İngilizce görselleri otomatik olarak Türkçeye çevirir ve çeviriyi orijinal yazının üstüne yerleştirir.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Webtoon Çevirmen",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Çeviriyi göster / gizle"
    }
  }
}
